# --- Database ---
MONGODB_URI=

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=90m
REFRESH_TOKEN_EXPIRES=30d
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# --- Runtime ---
NODE_ENV=development
APP_URL=https://tiwapulse.com
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# --- AI ---
OPENAI_API_KEY=
AI_COST_PER_REQUEST=30

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API=
EMAIL_FROM=

# --- Payments ---
PAYMENT_TEST_MODE=false
NEXT_PUBLIC_PAYMENT_TEST_MODE=false
NEXT_PUBLIC_BASE_CURRENCY=GBP

# --- Branding (drives logo, titles, metadata, copy) ---
NEXT_PUBLIC_SITE_DOMAIN=tiwapulse.com
NEXT_PUBLIC_SITE_URL=https://tiwapulse.com
NEXT_PUBLIC_SITE_TAGLINE=Social Media Growth Platform
NEXT_PUBLIC_SITE_DESCRIPTION=Boost your social media presence with premium likes, followers, and views for Instagram, TikTok, and YouTube.

# --- Company details (shown in footer, legal pages, contact) ---
NEXT_PUBLIC_COMPANY_NAME=TiwaPulse
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_COMPANY_VAT=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=

# --- Misc ---
ENVANTO_API=
